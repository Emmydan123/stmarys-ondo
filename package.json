{
  "name": "stmarys-ondo-church",
  "version": "1.0.0",
  "private": true,
  "description": "St. Mary's Anglican Church, Ondo website and administration backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
